# RAGAnything Configuration Example
# Copy this file to .env and fill in your values

# ============================================================================
# LLM Configuration
# ============================================================================
LLM_MODEL=google/gemini-3-pro-preview
VISION_MODEL=google/gemini-3-pro-preview
LLM_BINDING_API_KEY=your_api_key_here
LLM_BINDING_HOST=https://api.example.com

# ============================================================================
# Embedding Configuration
# ============================================================================
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIM=3072

# ============================================================================
# Timeout Settings (in seconds)
# ============================================================================
LLM_TIMEOUT=300
EMBEDDING_TIMEOUT=120

# ============================================================================
# Retrieval Strategy Configuration
# ============================================================================
# Options:
#   - adaptive: Use Adaptive-RAG to intelligently select modes (RECOMMENDED)
#               Automatically chooses 2-3 modes based on query complexity
#               Saves 40-60% API calls and execution time
#
#   - comprehensive: Query all 5 modes and compare (thorough but slower)
#                    Uses all modes: local, global, hybrid, naive, mix
#                    Best for research or when you need maximum coverage
#
RETRIEVAL_STRATEGY=adaptive

# ============================================================================
# Parser Configuration
# ============================================================================
# Options: mineru, docling
PARSER=mineru

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_DIR=.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
VERBOSE=false

# ============================================================================
# Adaptive RAG Advanced Settings (Optional)
# ============================================================================
# These settings are used internally by the adaptive RAG classifier
# You typically don't need to change these unless you're fine-tuning

# Complexity classification confidence threshold
# If confidence < threshold, defaults to moderate strategy
# ADAPTIVE_CONFIDENCE_THRESHOLD=0.3

# Custom mode strategies (comma-separated)
# ADAPTIVE_SIMPLE_MODES=naive,local
# ADAPTIVE_MODERATE_MODES=hybrid,local
# ADAPTIVE_COMPLEX_MODES=mix,global,hybrid
